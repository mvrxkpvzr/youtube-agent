{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_source.schema.json",
  "title": "Visual source (one line of visual_sources.jsonl) – every found item, used or not (knowledge/12)",
  "type": "object",
  "required": ["id", "kind", "title", "original_url", "accessed_at", "found_via", "rights_category", "rights_basis", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^V[0-9]{3,}$"},
    "kind": {"enum": ["video", "photo", "document", "social_post", "web_page", "court_record", "map_data", "audio", "reconstruction"]},
    "title": {"type": "string"},
    "publisher": {"type": ["string", "null"]},
    "author": {"type": ["string", "null"]},
    "original_url": {"type": "string"},
    "archive_url": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"]},
    "event_date": {"type": ["string", "null"]},
    "accessed_at": {"type": "string"},
    "found_via": {"type": "string", "description": "search query, archive path or method"},
    "language": {"type": ["string", "null"]},
    "what_it_shows": {"type": ["string", "null"]},
    "evidentiary_value": {"type": ["string", "null"], "description": "what it proves (claim ids) and its limits"},
    "authenticity_rank": {"type": "integer", "minimum": 1, "maximum": 6,
      "description": "1 original footage/document, 2 participant/original publisher, 3 trusted report/interview, 4 archive photo/document, 5 licensed public archive, 6 own reconstruction"},
    "rights_category": {"enum": ["A", "B", "C", "D", "E", "F"],
      "description": "A permission/licence obtained, B licence allows intended use, C public domain verified, D statutory exception (quotation/news/parody) possible, E unclear/high risk, F unusable"},
    "rights_basis": {"type": "string", "description": "Czech/EU law first; US fair use only as a secondary frame"},
    "commercial_ok": {"type": ["boolean", "null"]},
    "attribution": {"type": ["string", "null"]},
    "acquisition": {"enum": ["not_acquired", "preview_only", "downloaded"]},
    "local_file": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "proposed_scenes": {"type": "array", "items": {"type": "string", "pattern": "^SC[0-9]{3}$"}},
    "function": {"type": ["string", "null"], "enum": ["proves_claim", "original_promise", "contradiction", "testimony", "shows_event", "context", "object_of_critique", "irreplaceable_detail", null]},
    "max_range": {"type": ["string", "null"], "description": "e.g. 0:12–0:16 or full still"},
    "edit_notes": {"type": ["string", "null"]},
    "alternative": {"type": ["string", "null"]},
    "status": {"enum": ["candidate", "needs_human", "approved", "used", "rejected"]},
    "human_review": {"type": ["object", "null"], "properties": {"by": {"type": "string"}, "at": {"type": "string"}, "decision": {"type": "string"}}},
    "reject_reason": {"type": ["string", "null"]},
    "asset_id": {"type": ["string", "null"], "pattern": "^A[0-9]{3,}$"}
  },
  "additionalProperties": true
}
