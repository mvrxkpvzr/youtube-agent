{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference_observation.schema.json",
  "title": "Competitor reference library: one line of observations.jsonl",
  "description": "A single timestamped note about another creator's public video. kind=observation is what was directly seen/heard/read (transcript, player, thumbnail, metadata); kind=interpretation is our reading of why it works. Never stores their footage, narration audio or full scripts.",
  "type": "object",
  "required": ["id", "video", "category", "kind", "text", "confidence", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^O[0-9]{4}$"},
    "video": {"type": "string", "pattern": "^V-[a-z0-9]+-[0-9]{2}$"},
    "t_start": {"type": ["number", "null"], "minimum": 0},
    "t_end": {"type": ["number", "null"], "minimum": 0},
    "category": {"enum": ["hook", "promise", "structure", "revelation", "payoff", "pacing", "visual", "archival", "maps", "graphics", "3d", "animation", "voice", "music", "ambience", "silence", "transition", "evidence", "thumbnail", "title", "humor", "ethics"]},
    "kind": {"enum": ["observation", "interpretation"]},
    "text": {"type": "string", "minLength": 10, "maxLength": 600},
    "quote": {"type": ["string", "null"], "maxLength": 140, "description": "Optional short quote (<= 15 words) from the transcript, only to anchor a timestamp."},
    "confidence": {"enum": ["high", "medium", "low"]},
    "source": {"enum": ["transcript", "player", "storyboard", "thumbnail", "metadata", "description"]},
    "techniques": {"type": "array", "items": {"type": "string", "pattern": "^TQ-[0-9]{2}$"}}
  }
}
